{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./lib",
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "jsx": "react",
    "declaration": true,
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "./src"
  ],
  "exclude": [
    "node_modules",
    "./node_modules",
    "./node_modules/*",
    "lib",
    "*/__tests__/**",
  ]
}
